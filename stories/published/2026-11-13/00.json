{
  "script": {
    "working_title": "Her Gün Zararına Sattı, Kazanan O Oldu",
    "logline": "",
    "moral": "Bugün verdiğin küçük iyilik, yarın en büyük sermayen olur.",
    "music": "warm",
    "lines": [
      {
        "text": "Her gün zararına sattı. Kazanan yine o oldu.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Ferit Usta'nın küçücük bir bakkalı varmış.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Tam karşısına da kocaman bir market açılmış.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Ferit, şekeri çocuklara 1 liraya satarmış. Kendisine 2 liraya mal olurken.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Marketçi gülmüş: Sen batarsın Ferit!",
        "speaker": "young",
        "visual_intent": ""
      },
      {
        "text": "Ferit sadece gülümsemiş ve şeker vermeye devam etmiş.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Yıllar geçmiş. O çocuklar büyümüş.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Biri ev kurmuş, biri dükkân açmış, biri aşçı olmuş.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Ama hepsi alışverişini tek bir yerden yapmış: Ferit Usta'dan.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Bir sabah büyük market kepenk indirmiş.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Meğer Ferit şeker değil, güven satıyormuş.",
        "speaker": "narrator",
        "visual_intent": ""
      },
      {
        "text": "Sen bugün kime şeker veriyorsun? Yorumlara yaz.",
        "speaker": "narrator",
        "visual_intent": ""
      }
    ]
  },

     "props": [{"kind": "sun", "x": 0.8, "y": 0.14}, {"kind": "mountain", "x": 0.85, "scale": 0.35}]},
    {"text": "Yolda tartışmışlar. Biri öfkeyle ötekine tokat atmış.", "mood": "dusk", "camera": "shake",

     "props": [{"kind": "tree", "x": 0.85}, {"kind": "birds", "x": 0.2, "y": 0.2}]},
    {"text": "Tokat yiyen suya girmiş ve boğulmak üzereymiş.", "mood": "day", "camera": "shake",
     "chars": [{"x": 0.5, "pose": "cheer", "scale": 0.9}],
     "big": {"text": "İmdat!", "y": 0.14, "size": 160}},
    {"text": "Arkadaşı atlamış ve onu kurtarmış.", "mood": "day",
     "chars": [{"x": 0.4, "pose": "run", "walk_to": 0.55}, {"x": 0.7, "pose": "sad", "face": -1}],
     "props": [{"kind": "heart", "x": 0.5, "y": 0.26}]},
    {"text": "Kendine gelince, bu sefer bir taşa kazımış.", "mood": "day", "camera": "push",
     "chars": [{"x": 0.4, "pose": "work"}],
     "props": [{"kind": "stump", "x": 0.68, "scale": 1.3}],
     "big": {"text": "Bugün en yakın dostum hayatımı kurtardı.", "y": 0.18, "size": 76, "accent": false}},
    {"text": "Arkadaşı sormuş: Neden önce kuma, şimdi taşa yazdın?", "speaker": "young", "mood": "dusk",
     "chars": [{"x": 0.3, "pose": "talk"}, {"x": 0.7, "pose": "stand", "face": -1}],
     "props": [{"kind": "bubble", "x": 0.35, "y": 0.27, "text": "Neden kuma? Neden taşa?", "tail": 1}]},
    {"text": "Kırgınlıkları kuma yaz ki rüzgâr silsin. İyilikleri taşa kazı ki hiç silinmesin.", "speaker": "old", "mood": "night", "camera": "push",

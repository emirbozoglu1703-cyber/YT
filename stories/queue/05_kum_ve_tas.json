  "scenes": [
    {"text": "Tokat yedi. Ama cevap vermedi. Sadece yazdı.", "camera": "shake",
     "chars": [{"x": 0.5, "pose": "sad", "scale": 1.15}],
     "props": [{"kind": "question", "x": 0.75, "y": 0.27}]},
    {"text": "İki yakın arkadaş çölde yürüyormuş.", "mood": "dusk",

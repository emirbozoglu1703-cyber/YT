     "big": {"text": "ŞAK!", "y": 0.12, "size": 220}},
    {"text": "Tokat yiyen hiçbir şey dememiş. Eğilip kuma yazmış.", "mood": "dusk", "camera": "push", "focus": 0.5,
     "chars": [{"x": 0.5, "pose": "sit"}],
     "big": {"text": "Bugün en yakın dostum bana tokat attı.", "y": 0.18, "size": 76, "accent": false}},
    {"text": "Yürümeye devam etmişler ve bir vahaya varmışlar.", "mood": "day", "camera": "pan",

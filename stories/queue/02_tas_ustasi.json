{
  "id": "02_tas_ustasi",
  "title": "Yüz Darbe Vurdu, Taş Kırılmadı",
  "thumbnail_text": "100 darbe… taş kırılmadı",
  "description": "Bir taş ustası dev bir kayaya yüz kez vurur, kaya çatlamaz bile. Yüz birincide ne olur?",
  "tags": ["sabır", "pes etme", "taş ustası hikayesi", "motivasyon"],
  "music": "hopeful",
  "scenes": [
    {"text": "Yüz kere vurdu. Taş çatlamadı bile.", "camera": "shake",
     "chars": [{"x": 0.4, "pose": "work", "holds": "axe", "scale": 1.1}],
     "props": [{"kind": "mountain", "x": 0.8, "scale": 0.5}],
     "big": {"count_to": 100, "y": 0.1, "size": 230}},
    {"text": "Köyün yolunu dev bir kaya kapatmış. Herkes etrafından dolaşıyormuş.",
     "chars": [{"x": 0.2, "pose": "walk", "walk_to": 0.35}, {"x": 0.85, "pose": "stand", "face": -1}],
     "props": [{"kind": "mountain", "x": 0.55, "scale": 0.45}, {"kind": "cloud", "x": 0.2, "y": 0.18}]},
    {"text": "Bir taş ustası çekicini almış ve vurmaya başlamış.", "camera": "push", "focus": 0.4,
     "chars": [{"x": 0.35, "pose": "work", "holds": "axe"}],
     "props": [{"kind": "mountain", "x": 0.75, "scale": 0.45}]},
    {"text": "Bir. İki. On. Elli. Taşta tek bir iz yok.",
     "chars": [{"x": 0.35, "pose": "work", "holds": "axe"}],
     "props": [{"kind": "mountain", "x": 0.75, "scale": 0.45}, {"kind": "clock", "x": 0.2, "y": 0.22, "scale": 0.7, "speed": 8}],
     "big": {"count_to": 50, "y": 0.1, "size": 200, "count_time": 2.5}},
    {"text": "Geçenler gülmüş: Boşuna uğraşıyorsun usta!", "speaker": "young",
     "chars": [{"x": 0.25, "pose": "laugh"}, {"x": 0.65, "pose": "work", "holds": "axe", "face": -1}],
     "props": [{"kind": "bubble", "x": 0.3, "y": 0.27, "text": "Boşuna uğraşıyorsun!", "tail": 1}]},
    {"text": "Doksan dokuz. Hâlâ hiçbir şey.", "mood": "dusk", "camera": "push",
     "chars": [{"x": 0.4, "pose": "sad", "holds": "axe"}],
     "props": [{"kind": "mountain", "x": 0.78, "scale": 0.45}],
     "big": {"count_to": 99, "y": 0.1, "size": 230}},
    {"text": "Ve yüz birinci darbede, kaya ikiye ayrılmış.", "mood": "dusk", "camera": "shake",
     "chars": [{"x": 0.4, "pose": "cheer", "holds": "axe", "scale": 1.15}],
     "big": {"text": "ÇAT!", "y": 0.12, "size": 240}},
    {"text": "Herkes son darbeyi alkışlamış.", "mood": "dusk",
     "chars": [{"x": 0.2, "pose": "cheer"}, {"x": 0.5, "pose": "cheer", "holds": "axe"}, {"x": 0.8, "pose": "cheer", "face": -1}],
     "props": [{"kind": "birds", "x": 0.1, "y": 0.18}]},
    {"text": "Usta ise gülümsemiş: Kayayı son darbe kırmadı.", "mood": "night", "speaker": "old", "camera": "push", "focus": 0.5,
     "chars": [{"x": 0.5, "pose": "talk", "old": true, "holds": "axe", "scale": 1.1}],
     "props": [{"kind": "moon", "x": 0.8, "y": 0.15}]},
    {"text": "Önceki yüz darbenin hepsi kırdı.", "mood": "night", "speaker": "old",
     "chars": [{"x": 0.5, "pose": "point", "old": true}],
     "props": [{"kind": "moon", "x": 0.2, "y": 0.15}],
     "big": {"text": "100 + 1", "y": 0.2, "size": 200}},
    {"text": "Sen şu an kaçıncı darbedesin? Yorumlara yaz.", "mood": "night", "camera": "push",
     "chars": [{"x": 0.5, "pose": "point", "scale": 1.2}],
     "props": [{"kind": "question", "x": 0.74, "y": 0.26}]}
  ]
}

     "props": [{"kind": "moon", "x": 0.78, "y": 0.16}],
     "big": {"text": "Bilemek ≠ Vakit kaybı", "y": 0.25, "size": 110}},
    {"text": "Sen baltanı en son ne zaman biledin? Yorumlara yaz.", "mood": "night", "camera": "push",

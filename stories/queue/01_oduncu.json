     "props": [{"kind": "bubble", "x": 0.36, "y": 0.27, "text": "Yine mi oturdun?", "tail": 1}]},
    {"text": "Güneş batmış. Odunlar sayılmış.", "mood": "dusk", "camera": "pan",

     "props": [{"kind": "sun", "x": 0.78, "y": 0.14, "setting": true}, {"kind": "birds", "x": 0.1, "y": 0.2}]},
    {"text": "Hiç durmayan: otuz altı.", "mood": "dusk", "camera": "push",

     "props": [{"kind": "sun", "x": 0.82, "y": 0.13, "scale": 0.8}, {"kind": "cloud", "x": 0.1, "y": 0.2}]},
    {"text": "Genç olan sabahtan akşama bir an bile durmamış.", "mood": "day", "camera": "push",
     "chars": [{"x": 0.42, "pose": "work", "holds": "axe"}],
     "props": [{"kind": "tree", "x": 0.72}, {"kind": "logs", "x": 0.2, "count": 8, "grow": true, "scale": 0.8}]},
    {"text": "İhtiyar ise her saat başı oturmuş, gölgeye çekilmiş.", "mood": "day",

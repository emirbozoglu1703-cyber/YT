     "props": [{"kind": "tree", "x": 0.62}, {"kind": "clock", "x": 0.22, "y": 0.26, "scale": 0.8, "speed": 6}]},
    {"text": "Genç gülmüş: Yine mi oturdun ihtiyar?", "mood": "day", "speaker": "young",

     "props": [{"kind": "logs", "x": 0.68, "count": 9, "scale": 0.9}],
     "big": {"count_to": 36, "y": 0.12, "size": 260}},
    {"text": "Oturan: yetmiş sekiz.", "mood": "dusk", "camera": "shake",
     "chars": [{"x": 0.3, "pose": "stand", "old": true}],
     "props": [{"kind": "logs", "x": 0.68, "count": 20, "scale": 0.9}],
     "big": {"count_to": 78, "y": 0.12, "size": 260}},
    {"text": "Nasıl olur? Sen her saat dinleniyordun!", "mood": "dusk", "speaker": "young",
     "chars": [{"x": 0.32, "pose": "point"}, {"x": 0.7, "pose": "stand", "old": true, "face": -1}],
     "props": [{"kind": "bubble", "x": 0.35, "y": 0.27, "text": "Nasıl olur?!", "tail": 1}]},
    {"text": "Dinlenmiyordum, demiş ihtiyar. Baltamı biliyordum.", "mood": "dusk", "speaker": "old", "camera": "push", "focus": 0.6,
     "chars": [{"x": 0.6, "pose": "talk", "old": true, "face": -1, "holds": "axe", "scale": 1.15}],
     "props": [{"kind": "bubble", "x": 0.5, "y": 0.26, "text": "Baltamı biliyordum.", "tail": 1}]},
    {"text": "Seninki köreliyordu.", "mood": "dusk", "speaker": "old",

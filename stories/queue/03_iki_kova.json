{
  "id": "03_iki_kova",
  "title": "Çatlak Kova Yarısını Döktü, Ama…",
  "thumbnail_text": "Çatlak kova suyu döktü… ama",
  "description": "Bir sakanın iki kovası varmış. Biri sağlam, biri çatlak. Çatlak kova yıllarca utanmış. Ta ki bir gün…",
  "tags": ["kusur", "özgüven", "kova hikayesi", "kıssadan hisse"],
  "music": "warm",
  "scenes": [
    {"text": "İki yıl boyunca suyun yarısını döktü. Ve bu bir hata değildi.", "camera": "shake",
     "chars": [{"x": 0.5, "pose": "sad", "old": true, "scale": 1.1}],
     "props": [{"kind": "question", "x": 0.75, "y": 0.27}]},
    {"text": "Yaşlı bir sakanın omzunda iki kova varmış.",
     "chars": [{"x": 0.2, "pose": "walk", "old": true, "walk_to": 0.55}],
     "props": [{"kind": "road"}, {"kind": "sun", "x": 0.82, "y": 0.13, "scale": 0.8}]},
    {"text": "Biri sapasağlam. Öteki çatlak.", "camera": "push",
     "chars": [{"x": 0.5, "pose": "stand", "old": true}],
     "big": {"text": "Sağlam / Çatlak", "y": 0.2, "size": 120}},
    {"text": "Her gün çeşmeden eve yürürken, çatlak kova suyun yarısını yolda dökermiş.",
     "chars": [{"x": 0.3, "pose": "walk", "old": true, "walk_to": 0.7}],
     "props": [{"kind": "road"}, {"kind": "house", "x": 0.88, "scale": 0.7}]},
    {"text": "Bir gün kova dayanamamış: Özür dilerim, ben işe yaramıyorum.", "speaker": "child",
     "chars": [{"x": 0.6, "pose": "stand", "old": true, "face": -1}],
     "props": [{"kind": "bubble", "x": 0.4, "y": 0.27, "text": "Ben işe yaramıyorum…", "tail": 1}]},
    {"text": "Saka gülümsemiş: Yarın yürürken yolun kenarına bak.", "speaker": "old", "camera": "push", "focus": 0.5,
     "chars": [{"x": 0.5, "pose": "talk", "old": true}],
     "props": [{"kind": "bubble", "x": 0.5, "y": 0.26, "text": "Yolun kenarına bak.", "tail": -1}]},
    {"text": "Ertesi sabah kova bakmış. Yolun bir tarafı rengârenk çiçeklerle doluymuş.", "camera": "pan",
     "chars": [{"x": 0.3, "pose": "walk", "old": true, "walk_to": 0.6}],
     "props": [{"kind": "road"}, {"kind": "heart", "x": 0.2, "y": 0.45, "scale": 0.5}, {"kind": "heart", "x": 0.85, "y": 0.45, "scale": 0.5}, {"kind": "birds", "x": 0.2, "y": 0.2}]},
    {"text": "Öteki taraf ise kupkuru.",
     "chars": [{"x": 0.5, "pose": "think", "old": true}],
     "props": [{"kind": "stump", "x": 0.2}, {"kind": "stump", "x": 0.82}]},
    {"text": "Ben o tohumları senin tarafına ektim, demiş saka.", "speaker": "old", "mood": "dusk", "camera": "push",
     "chars": [{"x": 0.5, "pose": "point", "old": true}],
     "props": [{"kind": "tree", "x": 0.82, "scale": 0.8}]},
    {"text": "İki yıldır o çiçekleri sen suluyorsun.", "speaker": "old", "mood": "dusk",
     "chars": [{"x": 0.45, "pose": "cheer", "old": true}],
     "props": [{"kind": "heart", "x": 0.5, "y": 0.27}]},
    {"text": "Senin çatlağın, kimin yolunu çiçeklendiriyor? Yorumlara yaz.", "mood": "night", "camera": "push",
     "chars": [{"x": 0.5, "pose": "point", "scale": 1.2}],
     "props": [{"kind": "moon", "x": 0.8, "y": 0.14}, {"kind": "question", "x": 0.25, "y": 0.26}]}
  ]
}

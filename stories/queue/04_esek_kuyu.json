  "thumbnail_text": "Onu gömmek istediler…",
  "description": "Yaşlı bir eşek kuyuya düşer. Köylüler onu kurtaramayacaklarını anlayıp kuyuyu toprakla doldurmaya karar verir. Ama eşeğin başka bir planı vardır.",
  "tags": ["zorluklar", "pes etme", "kuyudaki eşek", "ibretlik hikaye"],
  "music": "mystery",
  "scenes": [
    {"text": "Üstüne toprak attılar. O ise yukarı çıktı.", "camera": "shake",
     "chars": [{"x": 0.5, "pose": "cheer", "scale": 1.1}],
     "big": {"text": "↑", "y": 0.12, "size": 260}},
    {"text": "Bir köylünün yaşlı eşeği, kuru bir kuyuya düşmüş.", "mood": "day",
     "chars": [{"x": 0.35, "pose": "sad", "hat": true}],
     "props": [{"kind": "stump", "x": 0.7, "scale": 1.6}, {"kind": "cloud", "x": 0.3, "y": 0.18}]},
    {"text": "Saatlerce uğraşmışlar. Çıkaramamışlar.", "camera": "push",
     "chars": [{"x": 0.3, "pose": "work", "hat": true}, {"x": 0.65, "pose": "work", "face": -1}],
     "props": [{"kind": "clock", "x": 0.5, "y": 0.24, "scale": 0.7, "speed": 8}]},
    {"text": "Köylü sonunda karar vermiş: Kuyuyu kapatalım. Eşek de içinde kalsın.", "speaker": "narrator", "mood": "dusk",
     "chars": [{"x": 0.5, "pose": "talk", "hat": true}],
     "props": [{"kind": "bubble", "x": 0.5, "y": 0.26, "text": "Kuyuyu kapatalım.", "tail": 1}]},
    {"text": "Herkes küreği almış ve toprak atmaya başlamış.", "mood": "dusk", "camera": "pan",
     "chars": [{"x": 0.2, "pose": "work"}, {"x": 0.5, "pose": "work", "hat": true}, {"x": 0.8, "pose": "work", "face": -1}],
     "props": [{"kind": "logs", "x": 0.5, "count": 3, "scale": 0.6}]},
    {"text": "Eşek önce acı acı bağırmış. Sonra birden susmuş.", "mood": "dusk", "camera": "shake",
     "chars": [{"x": 0.5, "pose": "think", "hat": true}],
     "props": [{"kind": "question", "x": 0.75, "y": 0.27}]},
    {"text": "Köylü kuyuya eğilip bakmış. Gözlerine inanamamış.", "mood": "dusk", "camera": "push", "focus": 0.5,
     "chars": [{"x": 0.5, "pose": "sad", "hat": true, "scale": 1.1}]},
    {"text": "Eşek her toprak yığınını silkeliyor, üstüne basıp bir adım yükseliyormuş.", "mood": "dusk",
     "chars": [{"x": 0.5, "pose": "cheer"}],
     "props": [{"kind": "logs", "x": 0.5, "count": 18, "grow": true, "scale": 0.9}]},
    {"text": "Ve son kürekle birlikte, kuyunun ağzından dışarı çıkıp gitmiş.", "mood": "night", "camera": "pan",
     "chars": [{"x": 0.3, "pose": "run", "walk_to": 0.8}],
     "props": [{"kind": "moon", "x": 0.8, "y": 0.15}]},
    {"text": "Hayat da üstüne toprak atar. Ya altında kalırsın, ya da basamak yaparsın.", "mood": "night",
     "chars": [{"x": 0.5, "pose": "think", "old": true}],
     "big": {"text": "Silkele ve bas", "y": 0.22, "size": 120}},
    {"text": "Bugün üstüne atılan toprak ne? Yorumlara yaz.", "mood": "night", "camera": "push",
     "chars": [{"x": 0.5, "pose": "point", "scale": 1.2}],
     "props": [{"kind": "question", "x": 0.74, "y": 0.26}]}
  ]
}
